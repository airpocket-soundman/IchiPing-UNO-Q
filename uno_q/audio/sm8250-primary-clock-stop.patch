diff --git a/sound/soc/qcom/sm8250.c b/sound/soc/qcom/sm8250.c
--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -19,6 +19,7 @@
 #define MI2S_BCLK_RATE		3072000
 
 struct sm8250_snd_data {
+	unsigned int primary_mi2s_users;
 	bool stream_prepared[AFE_PORT_MAX];
 	struct snd_soc_card *card;
 	struct sdw_stream_runtime *sruntime[AFE_PORT_MAX];
@@ -101,16 +102,27 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
+	struct sm8250_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
+	int ret;
 
 	switch (cpu_dai->id) {
 	case PRIMARY_MI2S_RX:
 	case PRIMARY_MI2S_TX:
 		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
-		snd_soc_dai_set_sysclk(cpu_dai,
-			Q6AFE_LPASS_CLK_ID_PRI_MI2S_IBIT,
-			MI2S_BCLK_RATE, substream->stream);
-		snd_soc_dai_set_fmt(cpu_dai, fmt);
-		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
+		ret = snd_soc_dai_set_fmt(cpu_dai, fmt);
+		if (ret < 0)
+			return ret;
+		ret = snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
+		if (ret < 0 && ret != -ENOTSUPP)
+			return ret;
+		if (!data->primary_mi2s_users) {
+			ret = snd_soc_dai_set_sysclk(cpu_dai,
+				Q6AFE_LPASS_CLK_ID_PRI_MI2S_IBIT,
+				MI2S_BCLK_RATE, substream->stream);
+			if (ret < 0)
+				return ret;
+		}
+		data->primary_mi2s_users++;
 		return 0;
 	case SECONDARY_MI2S_RX:
 		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
@@ -143,8 +156,14 @@ static void sm8250_snd_shutdown(struct snd_pcm_substream *substream)
 	struct sdw_stream_runtime *sruntime = data->sruntime[cpu_dai->id];
 
 	if (cpu_dai->id == PRIMARY_MI2S_RX ||
-	    cpu_dai->id == PRIMARY_MI2S_TX)
+	    cpu_dai->id == PRIMARY_MI2S_TX) {
+		if (data->primary_mi2s_users && !--data->primary_mi2s_users)
+			if (snd_soc_dai_set_sysclk(cpu_dai,
+				Q6AFE_LPASS_CLK_ID_PRI_MI2S_IBIT, 0,
+				substream->stream) < 0)
+				dev_err(rtd->dev, "primary MI2S clock stop failed\n");
 		return;
+	}
 
 	data->sruntime[cpu_dai->id] = NULL;
 	sdw_release_stream(sruntime);
