From: IchiPing UNO Q port
Subject: [PATCH] ASoC: qcom: sm8250: configure primary MI2S capture

The QRB2210 machine driver configures PRIMARY_MI2S_RX as a 48 kHz,
stereo, 32-bit, CPU-master I2S link but leaves PRIMARY_MI2S_TX at the
generic 16-bit defaults and does not enable its bit clock. Configure TX
symmetrically so a control-bus-free I2S microphone such as INMP441 can
use the primary MI2S capture backend.

Avoid allocating an unused SoundWire stream for primary MI2S links. This
matches the DAI filtering present in the current Arduino qcom-v7.0.0-unoq
SoundWire helper while keeping the change local to the older v6.16.7
machine driver.

diff --git a/sound/soc/qcom/sm8250.c b/sound/soc/qcom/sm8250.c
index 51bae458..71a1f1a8 100644
--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -79,6 +79,7 @@ static int sm8250_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 		channels->min = channels->max = 1;
 		break;
 	case PRIMARY_MI2S_RX:
+	case PRIMARY_MI2S_TX:
 	case SECONDARY_MI2S_RX:
 	case TERTIARY_MI2S_RX:
 		/* clean any param mask before setting new param */
@@ -103,13 +104,14 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 
 	switch (cpu_dai->id) {
 	case PRIMARY_MI2S_RX:
+	case PRIMARY_MI2S_TX:
 		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
 		snd_soc_dai_set_sysclk(cpu_dai,
 			Q6AFE_LPASS_CLK_ID_PRI_MI2S_IBIT,
-			MI2S_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
+			MI2S_BCLK_RATE, substream->stream);
 		snd_soc_dai_set_fmt(cpu_dai, fmt);
 		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
-		break;
+		return 0;
 	case SECONDARY_MI2S_RX:
 		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
 		snd_soc_dai_set_sysclk(cpu_dai,
@@ -140,6 +142,10 @@ static void sm8250_snd_shutdown(struct snd_pcm_substream *substream)
 	struct sm8250_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
 	struct sdw_stream_runtime *sruntime = data->sruntime[cpu_dai->id];
 
+	if (cpu_dai->id == PRIMARY_MI2S_RX ||
+	    cpu_dai->id == PRIMARY_MI2S_TX)
+		return;
+
 	data->sruntime[cpu_dai->id] = NULL;
 	sdw_release_stream(sruntime);
 }
